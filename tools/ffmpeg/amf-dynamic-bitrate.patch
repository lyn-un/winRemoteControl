     return ret;
 }
 
+static int amf_set_rate_property(AVCodecContext *avctx, const wchar_t *name, int64_t value)
+{
+    AMFEncoderContext *ctx = avctx->priv_data;
+    AMF_RESULT res;
+
+    AMF_ASSIGN_PROPERTY_INT64(res, ctx->encoder, name, value);
+    if (res != AMF_OK) {
+        av_log(avctx, AV_LOG_ERROR,
+               "amf_rate_update property=%ls requested=%"PRId64" result=%d\n",
+               name, value, res);
+        ctx->bitrate_error = AVERROR_EXTERNAL;
+        return ctx->bitrate_error;
+    }
+    return 0;
+}
+
+int ff_amf_update_h264_bitrate(AVCodecContext *avctx, int initializing)
+{
+    AMFEncoderContext *ctx = avctx->priv_data;
+    int64_t target = avctx->bit_rate;
+    int64_t peak = avctx->rc_max_rate;
+    int64_t buffer = avctx->rc_buffer_size;
+    int peak_first;
+
+    if (avctx->codec_id != AV_CODEC_ID_H264)
+        return 0;
+    if (ctx->bitrate_error)
+        return ctx->bitrate_error;
+    // Paused senders must not erase the last usable configuration.
+    if (!initializing && target <= 0)
+        return 0;
+    if (!peak && ctx->rate_control_mode == AMF_VIDEO_ENCODER_RATE_CONTROL_METHOD_CBR)
+        peak = target;
+    if (target < 0 || peak < 0 || buffer < 0 || (peak && peak < target)) {
+        av_log(avctx, AV_LOG_ERROR, "amf_rate_update invalid target/peak/buffer\n");
+        return ctx->bitrate_error = AVERROR(EINVAL);
+    }
+    if (target == ctx->applied_bitrate && peak == ctx->applied_peak_bitrate &&
+        buffer == ctx->applied_buffer_size)
+        return 0;
+    if (!initializing && ctx->rate_control_mode == AMF_VIDEO_ENCODER_RATE_CONTROL_METHOD_CONSTANT_QP) {
+        av_log(avctx, AV_LOG_ERROR, "amf_rate_update unsupported in constant QP mode\n");
+        return ctx->bitrate_error = AVERROR(ENOSYS);
+    }
+    // Zero is an initialization default, not a live property reset.
+    if (!initializing && ((!peak && ctx->applied_peak_bitrate) ||
+                         (!buffer && ctx->applied_buffer_size))) {
+        av_log(avctx, AV_LOG_ERROR, "amf_rate_update cannot reset live peak/buffer to default\n");
+        return ctx->bitrate_error = AVERROR(EINVAL);
+    }
+    // Raise the ceiling before the target; lower the target before the ceiling.
+    peak_first = peak > ctx->applied_peak_bitrate;
+    if (peak_first && amf_set_rate_property(avctx, AMF_VIDEO_ENCODER_PEAK_BITRATE, peak) < 0)
+        return ctx->bitrate_error;
+    if (buffer && buffer != ctx->applied_buffer_size &&
+        amf_set_rate_property(avctx, AMF_VIDEO_ENCODER_VBV_BUFFER_SIZE, buffer) < 0)
+        return ctx->bitrate_error;
+    if (target && target != ctx->applied_bitrate &&
+        amf_set_rate_property(avctx, AMF_VIDEO_ENCODER_TARGET_BITRATE, target) < 0)
+        return ctx->bitrate_error;
+    if (!peak_first && peak && peak != ctx->applied_peak_bitrate &&
+        amf_set_rate_property(avctx, AMF_VIDEO_ENCODER_PEAK_BITRATE, peak) < 0)
+        return ctx->bitrate_error;
+
+    // SetProperty is not transactional. Any partial failure stops encoding.
+    ctx->applied_bitrate = target;
+    ctx->applied_peak_bitrate = peak;
+    ctx->applied_buffer_size = buffer;
+    av_log(avctx, AV_LOG_INFO,
+           "amf_rate_update apiAcceptedTargetBps=%"PRId64" peakBps=%"PRId64
+           " bufferBits=%"PRId64" initializing=%d result=%d\n",
+           target, peak, buffer, initializing, AMF_OK);
+    return 0;
+}
+
